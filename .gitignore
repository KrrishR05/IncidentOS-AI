# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Local memory file — too large for git, regenerated by sync script
incident_memory.json

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
uvicorn.log

# Distribution / packaging
dist/
build/
*.egg-info/

# Frontend static files — not tracked in git
static/

# Node / Next.js — NEVER commit these
frontend/node_modules/
frontend/.next/
frontend/out/
node_modules/
.next/

# Python scratch files
copy_img.py
